# ---------------------------------------------------------------------------
# Copy this file to .env and fill in only what you need. Never commit .env.
# ---------------------------------------------------------------------------

# LLM is disabled for now. Allowed values: none | api | ollama
LLM_PROVIDER=none

# --- Hosted API provider (OpenAI-compatible) -------------------------------
# Default is OpenAI-compatible; Google AI Studio example:
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_MODEL=gemini-3.1-flash-lite
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_MODEL=gpt-4o-mini

# --- Local provider (Ollama) ------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Inference --------------------------------------------------------------
# Run `reviewed` rules in demo mode until a human reviewer activates them.
ALLOW_REVIEWED_RULES=true

# --- Retrieval --------------------------------------------------------------
# bm25 | tfidf | auto | sentence_transformers
EMBEDDING_BACKEND=bm25
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=qdrant
# Optional: connect to a Qdrant server (e.g. Docker) instead of local file mode.
# QDRANT_URL=http://localhost:6333
CHUNK_SIZE=1200
TOP_K=5

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Reject request bodies larger than this many bytes.
MAX_REQUEST_BYTES=1000000
